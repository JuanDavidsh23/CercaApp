{
  "expo": {
    "name": "Cerca",
    "slug": "cerca",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "cerca",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.cerca.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "app.cerca.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A"
      }
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Cerca uses your location to find nearby services.",
          "locationWhenInUsePermission": "Cerca uses your location to find nearby services."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F172A"
        }
      ],
      "expo-font",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    }
  }
}
