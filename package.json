{
  "name": "cerca",
  "version": "1.0.0",
  "private": true,
  "overrides": {
    "react": "19.2.3"
  },
  "scripts": {
    "verify": "bash scripts/verify.sh",
    "typecheck": "pnpm --filter @cerca/mobile typecheck",
    "lint": "pnpm --filter @cerca/mobile lint",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "mobile:start": "pnpm --filter @cerca/mobile start",
    "mobile:android": "pnpm --filter @cerca/mobile android",
    "mobile:ios": "pnpm --filter @cerca/mobile ios",
    "prepare": "husky"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2"
  },
  "lint-staged": {
    "apps/mobile/**/*.{ts,tsx}": [
      "eslint --fix --config apps/mobile/eslint.config.mjs",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
